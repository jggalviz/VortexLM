---
// src/components/ui/LanguageSelector.astro
//
// Selector de idioma (ES/EN) con bandera para el navbar.
//
// • Markup 100 % del servidor: funciona sin JavaScript (abre/cierra con
//   <details>, igual que el menú móvil del sitio).
// • El motor i18n del cliente (`src/i18n/client.ts`) conecta los botones,
//   aplica las traducciones y sincroniza bandera/código/opción activa.
// • Se renderiza en dos variantes: `desktop` (píldora en la barra superior) y
//   `mobile` (fila a ancho completo dentro del menú desplegable móvil).

import { DEFAULT_LOCALE, LOCALES, LOCALE_META } from '../../i18n/config';
import { FLAGS } from '../../i18n/flags';
import { UI } from '../../i18n/ui';

interface Props {
  variant?: 'desktop' | 'mobile';
  class?: string;
}

const { variant = 'desktop', class: className = '' } = Astro.props;
const isMobile = variant === 'mobile';
const current = DEFAULT_LOCALE;
const dict = UI[current];

const summaryClass = isMobile
  ? 'flex w-full items-center justify-between gap-2 list-none cursor-pointer px-5 py-3.5 text-xs text-[#a3a3a3] hover:bg-[#121216] hover:text-white transition-colors [&::-webkit-details-marker]:hidden'
  : 'inline-flex items-center gap-2 list-none cursor-pointer rounded-full border border-white/15 bg-white/[0.02] px-3 py-1.5 text-white/70 hover:text-white hover:border-white/30 transition-colors [&::-webkit-details-marker]:hidden';

const panelClass = isMobile
  ? 'absolute right-0 z-[120] mt-1 w-full min-w-[190px] overflow-hidden rounded-md border border-[#1f1f24] bg-[#08080c]/95 shadow-2xl'
  : 'absolute right-0 z-[120] mt-2 w-44 overflow-hidden rounded-md border border-[#1f1f24] bg-[#08080c]/95 shadow-2xl';
---

<div class={`relative ${className}`} data-lang-selector data-lang-variant={variant}>
  <details class="relative group/lang">
    <summary
      class={summaryClass}
      aria-label={dict['lang.ariaLabel']}
      data-i18n-aria-label="lang.ariaLabel"
    >
      {isMobile && (
        <span class="text-xs" data-i18n="lang.label">{dict['lang.label']}</span>
      )}

      <span class="inline-flex items-center gap-2">
        <span
          class="inline-flex h-3.5 w-5 shrink-0 overflow-hidden rounded-[2px] ring-1 ring-white/20"
          set:html={FLAGS[current]}
          data-lang-flag
        ></span>
        <span class="font-code text-[10px] font-medium tracking-widest" data-lang-code>
          {LOCALE_META[current].label}
        </span>
      </span>

      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 20 20"
        fill="currentColor"
        class="w-3 h-3 opacity-60 transition-transform duration-200 group-open/lang:rotate-180"
        aria-hidden="true"
      >
        <path
          fill-rule="evenodd"
          d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
          clip-rule="evenodd"
        ></path>
      </svg>
    </summary>

    <div class={panelClass} role="group">
      {LOCALES.map((locale) => {
        const meta = LOCALE_META[locale];
        const isActive = locale === current;
        return (
          <button
            type="button"
            data-lang-option={locale}
            data-active={isActive ? 'true' : 'false'}
            aria-pressed={isActive ? 'true' : 'false'}
            class="w-full flex items-center gap-3 px-4 py-2.5 text-left hover:bg-[#121216] data-[active=true]:bg-[#121216] transition-colors"
          >
            <span
              class="inline-flex h-3.5 w-5 shrink-0 overflow-hidden rounded-[2px] ring-1 ring-white/20"
              set:html={FLAGS[locale]}
            ></span>
            <span class="font-code text-[10px] font-medium tracking-widest text-white/70">
              {meta.label}
            </span>
            <span class="text-xs text-[#a3a3a3]">{meta.name}</span>
            <span
              class={`ml-auto material-symbols-outlined text-sm text-white ${isActive ? '' : 'opacity-0'}`}
              data-lang-check
              aria-hidden="true"
            >check</span>
          </button>
        );
      })}
    </div>
  </details>
</div>
