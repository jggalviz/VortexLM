---
// src/components/ui/MultipliersTable.astro
// Multiplicadores de consumo — hourly consumption rates table for VortexLM /precios page
// Self-contained component, no props, no external dependencies
---

<section
  class="relative w-full overflow-hidden bg-black"
  aria-label="Tarifas por hora — Multiplicadores de consumo" data-i18n-aria-label="multipliers.n26"
>
  <!-- Subtle top border glow -->
  <div
    class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-white/[0.06] to-transparent pointer-events-none"
    aria-hidden="true"
  ></div>

  <div class="relative">
    <div
      class="absolute inset-0 bg-gradient-to-b from-white/[0.02] to-transparent pointer-events-none"
      aria-hidden="true"
    ></div>

    <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 sm:py-32">
      <!-- Section header -->
      <div class="text-center mb-16 sm:mb-20">
        <!-- Pill badge -->
        <div class="flex justify-center mb-6">
          <span
            class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-linear-border bg-linear-charcoal/50 backdrop-blur-sm text-xs font-label-md tracking-wider uppercase text-linear-muted"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-linear-accent"></span>
            <span data-i18n="multipliers.n01">TARIFAS POR HORA</span>
          </span>
        </div>

        <h2
          class="text-center font-heading text-[clamp(1.75rem,4vw,3.25rem)] font-light tracking-tight text-white leading-[1.1] mb-4"
          style="font-family: 'Space Grotesk', sans-serif;"
        >
          <span data-i18n="multipliers.n02">Multiplicadores de</span> <span class="text-linear-accent"><span data-i18n="multipliers.n03">consumo</span></span>
        </h2>

        <p
          class="text-center text-neutral-400 font-body-md max-w-2xl mx-auto mb-16"
        >
          <span data-i18n="multipliers.n04">Cada servicio tiene un coste en vCredits por hora. Así de transparente.</span>
        </p>
      </div>

      <!-- Table container -->
      <div class="max-w-5xl mx-auto">
        <div class="overflow-x-auto rounded-xl border border-linear-border bg-linear-charcoal/80">
          <table class="w-full min-w-[640px]">
            <thead>
              <tr class="bg-linear-charcoal/60">
                <th
                  scope="col"
                  class="px-6 py-4 text-left text-xs font-label-md uppercase tracking-wider text-linear-muted"
                >
                  <span data-i18n="multipliers.n05">Servicio</span>
                </th>
                <th
                  scope="col"
                  class="px-6 py-4 text-right text-xs font-label-md uppercase tracking-wider text-linear-muted"
                >
                  <span data-i18n="multipliers.n06">vCredits/h</span>
                </th>
                <th
                  scope="col"
                  class="px-6 py-4 text-right text-xs font-label-md uppercase tracking-wider text-linear-muted"
                >
                  <span data-i18n="multipliers.n07">Precio final/h</span>
                </th>
              </tr>
            </thead>
            <tbody>
              <tr class="table-row border-t border-linear-border/40 transition-colors duration-300">
                <td class="px-6 py-4 text-sm font-body-md text-neutral-300">
                  <span data-i18n="multipliers.n08">Desarrollo Avanzado</span> <span class="text-neutral-500"><span data-i18n="multipliers.n09">(Astro, React, Next.js, APIs)</span></span>
                </td>
                <td class="px-6 py-4 text-right text-sm font-label-md text-linear-accent">
                  <span data-i18n="multipliers.n10">15 vCredits</span>
                </td>
                <td class="px-6 py-4 text-right text-sm font-label-md text-white">
                  $15.75 USD
                </td>
              </tr>
              <tr class="table-row border-t border-linear-border/40 transition-colors duration-300">
                <td class="px-6 py-4 text-sm font-body-md text-neutral-300">
                  <span data-i18n="multipliers.n11">Soporte & WPO</span> <span class="text-neutral-500"><span data-i18n="multipliers.n12">(WordPress, WooCommerce)</span></span>
                </td>
                <td class="px-6 py-4 text-right text-sm font-label-md text-linear-accent">
                  <span data-i18n="multipliers.n13">12 vCredits</span>
                </td>
                <td class="px-6 py-4 text-right text-sm font-label-md text-white">
                  $12.60 USD
                </td>
              </tr>
              <tr class="table-row border-t border-linear-border/40 transition-colors duration-300">
                <td class="px-6 py-4 text-sm font-body-md text-neutral-300">
                  <span data-i18n="multipliers.n14">Analítica Avanzada e Infraestructura</span> <span class="text-neutral-500"><span data-i18n="multipliers.n15">(GA4, GTM)</span></span>
                </td>
                <td class="px-6 py-4 text-right text-sm font-label-md text-linear-accent">
                  <span data-i18n="multipliers.n13">12 vCredits</span>
                </td>
                <td class="px-6 py-4 text-right text-sm font-label-md text-white">
                  $12.60 USD
                </td>
              </tr>
              <tr class="table-row border-t border-linear-border/40 transition-colors duration-300">
                <td class="px-6 py-4 text-sm font-body-md text-neutral-300">
                  <span data-i18n="multipliers.n16">Gestión de Campañas</span> <span class="text-neutral-500"><span data-i18n="multipliers.n17">(Google/Meta Ads)</span></span> <span data-i18n="multipliers.n18">y Diseño de Landings</span>
                </td>
                <td class="px-6 py-4 text-right text-sm font-label-md text-linear-accent">
                  <span data-i18n="multipliers.n19">10 vCredits</span>
                </td>
                <td class="px-6 py-4 text-right text-sm font-label-md text-white">
                  $10.50 USD
                </td>
              </tr>
              <tr class="table-row border-t border-linear-border/40 transition-colors duration-300">
                <td class="px-6 py-4 text-sm font-body-md text-neutral-300">
                  <span data-i18n="multipliers.n20">Edición de Video Corto para Anuncios</span> <span class="text-neutral-500"><span data-i18n="multipliers.n21">(Reels/TikTok)</span></span>
                </td>
                <td class="px-6 py-4 text-right text-sm font-label-md text-linear-accent">
                  <span data-i18n="multipliers.n22">8 vCredits</span>
                </td>
                <td class="px-6 py-4 text-right text-sm font-label-md text-white">
                  $8.40 USD
                </td>
              </tr>
              <tr class="table-row border-t border-linear-border/40 transition-colors duration-300">
                <td class="px-6 py-4 text-sm font-body-md text-neutral-300">
                  <span data-i18n="multipliers.n23">Diseño de Creativos y Banners Estáticos</span>
                </td>
                <td class="px-6 py-4 text-right text-sm font-label-md text-linear-accent">
                  <span data-i18n="multipliers.n24">6 vCredits</span>
                </td>
                <td class="px-6 py-4 text-right text-sm font-label-md text-white">
                  $6.30 USD
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Info note -->
        <p
          class="text-center text-sm text-linear-muted font-body-md mt-6"
        >
          <span data-i18n="multipliers.n25">Los vCredits se descuentan por minuto real de desarrollo. Sin redondeos.</span>
        </p>
      </div>
    </div>

    <div
      class="absolute bottom-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-white/[0.06] to-transparent"
      aria-hidden="true"
    ></div>
  </div>
</section>

<style>
  /* Alternating row backgrounds */
  .table-row:nth-child(even) {
    background: rgba(255, 255, 255, 0.015);
  }

  .table-row:nth-child(odd) {
    background: transparent;
  }

  /* Hover effect — brighten row */
  .table-row:hover {
    background: rgba(255, 255, 255, 0.04);
  }

  /* Ensure Space Grotesk is applied for headings even before full CSS loads */
  section h2 {
    font-family: 'Space Grotesk', sans-serif;
  }
</style>
