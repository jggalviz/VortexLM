---
import BaseLayout from '../../layouts/BaseLayout.astro';

/* ───────────────────────────────────────────────────────────────────────────
 *  /servicios/administrador-aplicaciones-empresariales
 *
 *  Página del perfil "Administrador de Aplicaciones Empresariales" (perfil 03
 *  del directorio de /servicios). Explica la administración, el soporte y la
 *  operación de las aplicaciones corporativas —CRM, ERP, DXP, IAM e ITSM—: el
 *  ciclo de vida completo (identidades, permisos, integraciones, licenciamiento,
 *  actualizaciones), el soporte L2/L3 y la relación con proveedores.
 *
 *  La URL antigua /servicios/administrador-aplicaciones-web responde con un 301
 *  a esta página (redirect declarado en astro.config.mjs).
 *
 *  Estructura:
 *    1. Hero con la propuesta de valor y métricas operativas del servicio
 *    2. Capacidades: IAM, integraciones, ciclo de vida, soporte L2/L3, gobernanza
 *    3. Plataformas empresariales que administramos
 *    4. Método de trabajo en cuatro fases
 *    5. FAQ (alimenta el FAQPage de SEO.astro vía BaseLayout)
 *    6. Interlinking interno hacia el resto del sitio
 *    7. CTA final: formulario /api/contact + consulta directa por WhatsApp
 *
 *  Convención i18n del repo: cada texto visible va marcado con `data-i18n*` y su
 *  valor español vive en una sola línea de origen para que el HTML servido sea
 *  idéntico al diccionario `es` (lo verifica el crawl SSR).
 * ─────────────────────────────────────────────────────────────────────────── */

interface AdminCapability {
  step: string;
  slug: string;
  title: string;
  description: string;
  points: string[];
}

interface ManagedPlatform {
  slug: string;
  name: string;
  note: string;
}

/** Métricas operativas del servicio — todas verificables con la operación real */
const heroStats = [
  { value: '99.9%', label: 'Uptime objetivo en plataformas críticas', slug: 'uptime' },
  { value: '≤ 2 h', label: 'Primera respuesta ante incidentes L2/L3', slug: 'respuesta' },
  { value: '15+', label: 'Plataformas empresariales gestionadas', slug: 'plataformas' },
  {
    value: '100%',
    label: 'Gestión de identidades y accesos centralizada',
    slug: 'identidades',
  },
];

/** Capacidades del servicio de administración de aplicaciones empresariales */
const capabilities: AdminCapability[] = [
  {
    step: '01',
    slug: 'iam',
    title: 'Gestión de identidades y accesos (IAM)',
    description:
      'Administramos quién puede ver qué dentro de cada aplicación. Configuramos SSO, roles, permisos y políticas de acceso mínimo con Okta, Microsoft Entra ID o el proveedor de identidad corporativo.',
    points: [
      'SSO y autenticación centralizada con Okta o Entra ID',
      'Gestión de roles y permisos por aplicación y por área',
      'Aprovisionamiento y desaprovisionamiento de usuarios',
      'Auditoría de accesos y cumplimiento de políticas internas',
    ],
  },
  {
    step: '02',
    slug: 'integracion',
    title: 'Integración de CRM, ERP y sistemas corporativos',
    description:
      'Conectamos las aplicaciones entre sí —CRM, ERP, DXP, pagos, mesa de ayuda— y eliminamos la carga manual y los errores de datos duplicados.',
    points: [
      'CRM: Salesforce, Microsoft Dynamics 365, HubSpot, Zoho',
      'ERP: Dynamics 365 Business Central, NetSuite, SAP',
      'DXP: Liferay DXP, Sitefinity, Adobe Experience Manager',
      'APIs REST, middleware, webhooks y sincronización de datos',
    ],
  },
  {
    step: '03',
    slug: 'ciclo-de-vida',
    title: 'Mantenimiento, actualizaciones y ciclo de vida',
    description:
      'Gestionamos versiones, parches, licenciamiento y roadmap de cada plataforma para que nunca te sorprenda una actualización crítica ni una renovación de contrato.',
    points: [
      'Actualizaciones de versión y parches de seguridad',
      'Gestión de licencias, renovaciones y relación con proveedores',
      'Entornos de staging y pruebas antes de cada cambio',
      'Informe mensual de estado, cambios y riesgos',
    ],
  },
  {
    step: '04',
    slug: 'soporte',
    title: 'Soporte L2/L3 y gestión de incidencias',
    description:
      'Resolvemos incidencias complejas que el helpdesk inicial no puede atender, con canal directo y tiempos de respuesta comprometidos por contrato.',
    points: [
      'Soporte L2/L3 sobre aplicaciones empresariales',
      'Gestión de tickets, cambios e incidentes bajo ITIL',
      'ServiceNow y Jira Service Management como mesas de ayuda',
      'Documentación de soluciones y base de conocimiento',
    ],
  },
  {
    step: '05',
    slug: 'gobernanza',
    title: 'Gobernanza y adopción',
    description:
      'Aseguramos que la plataforma se use bien: formamos usuarios, revisamos adopción y alineamos la configuración con los procesos reales del negocio.',
    points: [
      'Formación y onboarding de usuarios internos',
      'Revisión de adopción y buenas prácticas de uso',
      'Gobernanza de datos y cumplimiento normativo',
      'Alineación entre configuración técnica y procesos de negocio',
    ],
  },
];

/** Plataformas empresariales que administramos (12 entornos en total) */
const platforms: ManagedPlatform[] = [
  { slug: 'salesforce', name: 'Salesforce', note: 'CRM, Service Cloud, Marketing Cloud y gestión de usuarios' },
  { slug: 'dynamics365', name: 'Microsoft Dynamics 365', note: 'CRM, ERP y ecosistema Power Platform' },
  { slug: 'liferay', name: 'Liferay DXP', note: 'Portales corporativos, intranets y experiencias digitales' },
  { slug: 'sitefinity', name: 'Sitefinity', note: 'CMS empresarial y sitios corporativos' },
  { slug: 'aem', name: 'Adobe Experience Manager', note: 'DXP para grandes organizaciones' },
  { slug: 'okta', name: 'Okta', note: 'Gestión de identidades y SSO' },
  { slug: 'entra-id', name: 'Microsoft Entra ID', note: 'Directorio activo en la nube y acceso condicional' },
  { slug: 'servicenow', name: 'ServiceNow', note: 'ITSM, tickets, cambios e incidentes' },
  { slug: 'jira-service-management', name: 'Jira Service Management', note: 'Mesa de ayuda y gestión de servicios' },
  { slug: 'hubspot', name: 'HubSpot', note: 'CRM para equipos de ventas y marketing' },
  { slug: 'zoho', name: 'Zoho CRM', note: 'CRM para pymes y equipos en crecimiento' },
  { slug: 'wordpress-vip', name: 'WordPress VIP', note: 'CMS empresarial para sitios de alto tráfico' },
];

/** Método de trabajo en cuatro fases */
const methodSteps = [
  {
    slug: 'diagnostico',
    name: 'Diagnóstico y traspaso',
    description:
      'Auditamos accesos, identidades, integraciones, licencias y riesgos de cada plataforma. Firmamos el acuerdo de niveles de servicio antes de tocar nada.',
  },
  {
    slug: 'puesta-en-operacion',
    name: 'Puesta en operación',
    description:
      'Configuramos SSO, roles y permisos, montamos staging, documentamos integraciones y dejamos el sistema monitorizado con alertas desde el primer día.',
  },
  {
    slug: 'operacion',
    name: 'Operación continua',
    description:
      'Gestionamos actualizaciones, backups verificados, revisiones de seguridad, soporte L2/L3 y relación con proveedores dentro de los tiempos acordados.',
  },
  {
    slug: 'evolucion',
    name: 'Optimización y evolución',
    description:
      'Cada mes revisamos adopción, rendimiento y roadmap de cada plataforma contigo y planificamos las mejoras que más impacto tienen en tu operación.',
  },
];

/** FAQ — alimenta el JSON-LD FAQPage que emite SEO.astro desde BaseLayout */
const faqs = [
  {
    slug: 'alcance',
    question: '¿Qué incluye exactamente la administración de aplicaciones empresariales?',
    answer:
      'Incluye la gestión de identidades y accesos, integraciones entre plataformas, actualizaciones y parches, gestión de licencias, soporte L2/L3, documentación y gobernanza. No hace falta que tengas un equipo interno dedicado: actuamos como tu área de operaciones de aplicaciones corporativas.',
  },
  {
    slug: 'hecho-por-otro-proveedor',
    question: '¿Pueden administrar una aplicación que no desarrolló VortexLM?',
    answer:
      'Sí. Trabajamos sobre Salesforce, Dynamics 365, Liferay, Sitefinity, AEM, Okta, ServiceNow y otras plataformas desarrolladas o implementadas por cualquier proveedor. Empezamos con un diagnóstico y un traspaso ordenado de accesos y documentación.',
  },
  {
    slug: 'incidencia-fin-de-semana',
    question: '¿Qué pasa si una aplicación crítica se cae un fin de semana?',
    answer:
      'Los planes de operación continua incluyen monitoreo 24/7 con alertas automáticas. Si el sistema detecta una caída, recibimos el aviso y actuamos sin esperar a que lo notes. Los incidentes críticos tienen un tiempo de primera respuesta comprometido por contrato.',
  },
  {
    slug: 'migracion',
    question: '¿Pueden migrar una aplicación empresarial a otra infraestructura sin tiempo de caída?',
    answer:
      'Sí. Trabajamos con staging, verificación de datos y ventanas de mantenimiento acordadas contigo. Hemos movido plataformas entre proveedores de hosting, base de datos e identidad manteniendo el servicio en línea y sin perder datos de negocio.',
  },
  {
    slug: 'precios',
    question: '¿Cómo se cobra la administración mensual de aplicaciones empresariales?',
    answer:
      'Con una cuota mensual fija según la complejidad de las plataformas, el número de integraciones y el nivel de soporte que necesites. Las mejoras evolutivas, migraciones y proyectos nuevos se cotizan aparte con alcance y plazos claros.',
  },
];

/** Interlinking interno hacia el resto del sitio */
const relatedLinks = [
  {
    href: '/servicios',
    slug: 'directorio',
    label: 'Directorio de servicios y perfiles técnicos',
    description: 'Compara los cuatro perfiles técnicos del directorio y combina los que necesite tu proyecto.',
  },
  {
    href: '/servicios/desarrollo-wordpress',
    slug: 'cms',
    label: 'Desarrollo WordPress avanzado',
    description: 'El perfil de CMS: sitios y tiendas que después actualizamos, respaldamos y monitorizamos.',
  },
  {
    href: '/servicios/programador-web-caracas',
    slug: 'fullstack',
    label: 'Desarrollador full-stack senior',
    description: 'Cuando la operación detecta deuda técnica, el mismo equipo puede rehacer la arquitectura.',
  },
  {
    href: '/servicios/sistemas-gestion-medida',
    slug: 'sistemas',
    label: 'Sistemas de gestión a medida',
    description: 'Paneles internos y software de gestión a los que damos soporte y mantenemos conectados.',
  },
];

/** Consulta directa por WhatsApp (mismo número corporativo del sitio) */
const whatsappHref = `https://wa.me/584228101010?text=${encodeURIComponent(
  'Hola Vortex, quiero un plan de administración para nuestras aplicaciones empresariales (CRM, ERP, DXP, IAM). He visto el servicio en vortexlm.com y me gustaría recibir un diagnóstico y una propuesta de soporte.'
)}`;

/* ── Datos estructurados ───────────────────────────────────────────────────
 * SEO.astro ya emite el ProfessionalService y el FAQPage desde BaseLayout;
 * aquí sumamos el Service con su catálogo de planes de administración.
 * Los scripts son datos (no código) y van auto-cerrados: el runner de lint
 * exige que no queden etiquetas <script> sin cerrar.
 * ──────────────────────────────────────────────────────────────────────── */
const appsEnterpriseServiceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Administración de Aplicaciones Empresariales',
  serviceType:
    'Administración, integración y soporte de aplicaciones empresariales (CRM, ERP, DXP, IAM e ITSM)',
  url: 'https://vortexlm.com/servicios/administrador-aplicaciones-empresariales',
  description:
    'Administración de aplicaciones empresariales: gestión de identidades y accesos (Okta, Microsoft Entra ID), integración de CRM, ERP y DXP (Salesforce, Dynamics 365, Liferay, Sitefinity, Adobe Experience Manager), mantenimiento y ciclo de vida, gestión de licencias, soporte L2/L3 (ServiceNow, Jira Service Management) y gobernanza.',
  provider: {
    '@type': 'ProfessionalService',
    name: 'Vortex Logic Microsystems LLC',
    url: 'https://vortexlm.com',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Caracas',
      addressRegion: 'Distrito Capital',
      addressCountry: 'VE',
    },
  },
  areaServed: [
    { '@type': 'City', name: 'Caracas' },
    { '@type': 'Country', name: 'Venezuela' },
    { '@type': 'Country', name: 'Espana' },
  ],
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/InStock',
    priceCurrency: 'USD',
    description:
      'Cuota mensual de administración según la complejidad de las plataformas, el número de integraciones y el nivel de soporte; mejoras evolutivas y proyectos cotizados aparte.',
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Planes de administración de aplicaciones empresariales',
    itemListElement: [
      {
        '@type': 'Offer',
        name: 'Operación esencial',
        description: 'Actualizaciones y parches controlados, copias de seguridad verificadas y monitorización de disponibilidad con alertas.',
      },
      {
        '@type': 'Offer',
        name: 'Operación continua',
        description: 'Gobernanza de identidades (SSO, roles y permisos), integraciones CRM/ERP/DXP, revisiones de seguridad y soporte L2/L3 con tiempos comprometidos.',
      },
      {
        '@type': 'Offer',
        name: 'Soporte a medida',
        description: 'Bolsa de horas para incidencias, migraciones, gestión de licencias y proyectos puntuales sobre plataformas corporativas.',
      },
    ],
  },
};
---

<BaseLayout
  title="Administrador de Aplicaciones Empresariales en Caracas | CRM, ERP, IAM y Soporte L2/L3"
  description="Administración de aplicaciones empresariales en Caracas: CRM, ERP, DXP e IAM sobre Salesforce, Dynamics 365, Liferay, Okta y ServiceNow, con gobernanza de identidades, integraciones, soporte L2/L3 y ciclos de vida planificados."
  titleKey="svcAppsAdmin.meta.title"
  descriptionKey="svcAppsAdmin.meta.description"
  type="website"
  isLocalBusiness={true}
  faqItems={faqs}
>
  <!-- Datos estructurados de la página (Service + catálogo de planes).
       Se emiten dentro del body porque BaseLayout no expone un slot de <head>;
       Google acepta JSON-LD en cualquier punto del documento. -->
  <script type="application/ld+json" set:html={JSON.stringify(appsEnterpriseServiceSchema)} />

<!-- ─── HERO + PROPUESTA DE VALOR ───────────────────────────────── -->
<section class="relative pt-36 pb-28 overflow-hidden linear-gradient-bg border-b border-[#1f1f24] px-6 md:px-12">
  <div class="absolute inset-0 linear-grid opacity-30 pointer-events-none"></div>
  <div class="max-w-[1200px] mx-auto text-center relative z-10">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-white/[0.015] blur-[120px] rounded-full pointer-events-none"></div>

    <span class="inline-block px-3 py-1.5 border border-[#1f1f24] rounded-full text-[10px] font-mono uppercase tracking-widest text-[#8a8a93] mb-8" data-i18n="svcAppsAdmin.n01">
      Administrador de Aplicaciones Empresariales
    </span>

    <h1 class="text-4xl md:text-7xl font-extralight tracking-tight text-white mb-8 leading-[1.08] max-w-4xl mx-auto opacity-95" data-i18n="svcAppsAdmin.n02">
      Administrador de aplicaciones empresariales: CRM, ERP y portales corporativos bajo control
    </h1>

    <!-- Propuesta de valor del servicio. El texto va en una sola línea de
         origen para que aparezca idéntico en el HTML servido. -->
    <div class="linear-card glow-hover rounded-lg border border-[#1f1f24] bg-[#08080c]/60 px-6 py-7 md:px-10 md:py-9 max-w-4xl mx-auto mb-10 text-left">
      <div class="border-l-2 border-white/20 pl-5 md:pl-7">
        <span class="text-[10px] font-mono uppercase tracking-widest text-[#8a8a93] block mb-3" data-i18n="svcAppsAdmin.n03">Qué hace un administrador de aplicaciones empresariales</span>
        <p class="text-base md:text-xl text-white font-light leading-relaxed tracking-tight" data-i18n="svcAppsAdmin.n04">Gestionamos las plataformas que sostienen tu operación —Salesforce, Dynamics 365, Liferay, Okta, ServiceNow— con gobernanza de identidades, integraciones, soporte L2/L3 y ciclos de vida planificados. Tu equipo se dedica al negocio; nosotros a que las aplicaciones empresariales funcionen como el primer día.</p>
      </div>
    </div>

    <!-- Métricas operativas del servicio -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4 max-w-4xl mx-auto mb-12">
      {heroStats.map((stat) => (
        <div class="linear-card glow-hover rounded-lg border border-[#1f1f24] bg-[#08080c]/40 px-4 py-5 text-center">
          <div class="text-2xl md:text-3xl font-light text-white tracking-tight">{stat.value}</div>
          <div class="text-[10px] font-mono uppercase tracking-wider text-[#8a8a93] mt-2 leading-snug" data-i18n={`svcAppsAdmin.stat.${stat.slug}`}>{stat.label}</div>
        </div>
      ))}
    </div>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-6">
      <a href="#contacto" class="w-full sm:w-auto px-8 py-3 bg-white text-black font-semibold text-xs rounded-full hover:bg-neutral-200 transition-all text-center duration-200 active:scale-95 shadow-[0_0_25px_rgba(255,255,255,0.15)]" data-i18n="svcAppsAdmin.n05">
        Quiero administración y soporte
      </a>
      <a href="#capacidades" class="w-full sm:w-auto px-6 py-3 text-white/90 font-medium text-xs rounded-full hover:text-white flex items-center justify-center gap-1.5 group transition-colors">
        <span data-i18n="svcAppsAdmin.n06">Ver las</span> <span data-i18n="svcAppsAdmin.n07">capacidades del servicio</span>
        <span class="group-hover:translate-x-1 transition-transform">➔</span>
      </a>
    </div>
  </div>
</section>

<!-- ─── CAPACIDADES: ADMINISTRACIÓN DE APLICACIONES EMPRESARIALES ── -->
<section id="capacidades" class="py-24 md:py-32 px-6 md:px-12 bg-black border-b border-[#1f1f24] relative">
  <div class="max-w-[1200px] mx-auto relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-[10px] font-mono text-[#8a8a93] uppercase tracking-widest block mb-3 font-medium" data-i18n="svcAppsAdmin.n08">Cómo trabajamos</span>
      <h2 class="text-3xl md:text-5xl font-light text-white tracking-tight mb-6" data-i18n="svcAppsAdmin.n09">Qué incluye la administración de tus aplicaciones empresariales</h2>
      <p class="text-sm md:text-base text-[#cbd5e1] font-light leading-relaxed" data-i18n="svcAppsAdmin.n10">Una aplicación empresarial no se mantiene sola. Gestionamos las cinco áreas críticas de la operación —identidades, integraciones, mantenimiento, soporte y gobernanza— para que tu equipo se dedique a lo suyo y la plataforma siga alineada con el negocio.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {capabilities.map((capability) => (
        <article class="linear-card glow-hover rounded-lg border border-[#1f1f24] bg-[#08080c]/40 p-6 lg:p-8 transition-all">
          <div class="flex items-center gap-3 mb-5">
            <span class="text-[10px] font-mono text-[#8a8a93] uppercase tracking-widest">{capability.step}</span>
            <span class="glow-line flex-grow" aria-hidden="true"></span>
          </div>
          <h3 class="text-lg md:text-xl font-light text-white tracking-tight mb-3" data-i18n={`svcAppsAdmin.capability.${capability.slug}.title`}>{capability.title}</h3>
          <p class="text-xs text-[#cbd5e1] font-light leading-relaxed mb-5" data-i18n={`svcAppsAdmin.capability.${capability.slug}.description`}>{capability.description}</p>
          <ul class="space-y-1.5 text-[10px] text-[#cbd5e1] font-mono">
            {capability.points.map((point, k) => (
              <li class="flex items-start gap-2">
                <span class="text-white/70" aria-hidden="true">→</span>
                <span data-i18n={`svcAppsAdmin.capability.${capability.slug}.point.${k}`}>{point}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ─── PLATAFORMAS EMPRESARIALES QUE ADMINISTRAMOS ─────────────── -->
<section class="py-24 md:py-32 px-6 md:px-12 bg-black border-b border-[#1f1f24] relative">
  <div class="max-w-[1200px] mx-auto relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-[10px] font-mono text-[#8a8a93] uppercase tracking-widest block mb-3 font-medium" data-i18n="svcAppsAdmin.n11">Plataformas</span>
      <h2 class="text-3xl md:text-5xl font-light text-white tracking-tight mb-6" data-i18n="svcAppsAdmin.n12">Plataformas empresariales que administramos a diario</h2>
      <p class="text-sm md:text-base text-[#cbd5e1] font-light leading-relaxed" data-i18n="svcAppsAdmin.n13">No hace falta que tu equipo conozca cada consola, cada panel de facturación o cada cuota de API. Estos son los entornos corporativos sobre los que operamos todos los días y con los que tu empresa probablemente ya cuenta.</p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4">
      {platforms.map((platform) => (
        <div class="linear-card glow-hover rounded-lg border border-[#1f1f24] bg-[#08080c]/40 p-5 flex flex-col gap-2">
          <span class="font-mono text-xs text-white break-words" data-i18n={`svcAppsAdmin.platform.${platform.slug}.name`}>{platform.name}</span>
          <span class="text-[10px] font-mono uppercase tracking-wider text-[#8a8a93] leading-snug" data-i18n={`svcAppsAdmin.platform.${platform.slug}.note`}>{platform.note}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ─── MÉTODO DE TRABAJO EN CUATRO FASES ───────────────────────── -->
<section class="py-24 md:py-32 px-6 md:px-12 bg-black border-b border-[#1f1f24] relative">
  <div class="max-w-[1200px] mx-auto relative z-10">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="text-[10px] font-mono text-[#8a8a93] uppercase tracking-widest block mb-3 font-medium" data-i18n="svcAppsAdmin.n14">Método</span>
      <h2 class="text-3xl md:text-4xl font-light text-white tracking-tight" data-i18n="svcAppsAdmin.n15">Cómo pasamos tus aplicaciones a operación administrada</h2>
    </div>

    <ol class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {methodSteps.map((step, index) => (
        <li class="linear-card glow-hover rounded-lg border border-[#1f1f24] bg-[#08080c]/40 p-6 lg:p-7 transition-all">
          <span class="text-[10px] font-mono text-[#8a8a93] uppercase tracking-widest block mb-4">{String(index + 1).padStart(2, '0')}</span>
          <h3 class="text-base md:text-lg font-light text-white tracking-tight mb-3" data-i18n={`svcAppsAdmin.step.${step.slug}.name`}>{step.name}</h3>
          <p class="text-xs text-[#cbd5e1] font-light leading-relaxed" data-i18n={`svcAppsAdmin.step.${step.slug}.description`}>{step.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- ─── FAQ ─────────────────────────────────────────────────────── -->
<section class="py-24 md:py-32 px-6 md:px-12 bg-black border-b border-[#1f1f24] relative">
  <div class="max-w-[800px] mx-auto relative z-10">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="text-[10px] font-mono text-[#cbd5e1] uppercase tracking-widest block mb-3 font-medium" data-i18n="svcAppsAdmin.n16">FAQ</span>
      <h2 class="text-3xl md:text-4xl font-light text-white tracking-tight" data-i18n="svcAppsAdmin.n17">Preguntas frecuentes sobre administración de aplicaciones empresariales</h2>
    </div>

    <div class="space-y-4">
      {faqs.map((faq) => (
        <details class="group linear-card rounded-lg border border-[#1f1f24] bg-[#08080c]/30 overflow-hidden glow-hover transition-all">
          <summary class="flex items-center justify-between gap-4 p-5 cursor-pointer text-sm font-medium text-white/90 hover:text-white transition-colors">
            <span data-i18n={`svcAppsAdmin.faq.${faq.slug}.question`}>{faq.question}</span>
            <span class="material-symbols-outlined text-sm text-[#cbd5e1]/60 group-open:rotate-180 transition-transform shrink-0" data-i18n="svcAppsAdmin.n18">expand_more</span>
          </summary>
          <div class="px-5 pb-5 text-xs text-[#cbd5e1] leading-relaxed">
            <span data-i18n={`svcAppsAdmin.faq.${faq.slug}.answer`}>{faq.answer}</span>
          </div>
        </details>
      ))}
