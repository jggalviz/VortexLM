<!-- ─── CTA FINAL: FORMULARIO + WHATSAPP ────────────────────────── -->
<section id="contacto" class="py-24 md:py-36 px-6 md:px-12 bg-black relative">
  <div class="max-w-[600px] mx-auto text-center relative z-10 space-y-8">
    <span class="text-[10px] font-mono text-[#cbd5e1] uppercase tracking-widest block font-medium" data-i18n="svcAppsAdmin.n22">Trabajemos juntos</span>
    <h2 class="text-3xl md:text-5xl font-light text-white tracking-tight leading-tight" data-i18n="svcAppsAdmin.n23">
      ¿Necesitas administrar tus aplicaciones empresariales?
    </h2>
    <p class="text-sm text-[#cbd5e1] font-light leading-relaxed" data-i18n="svcAppsAdmin.n24">
      Cuéntanos qué plataformas tienes en producción —Salesforce, Dynamics, Liferay, Okta, ServiceNow o cualquier otra— y recibirás un diagnóstico y un plan de administración con alcance, plazos y presupuesto transparente. Sin compromiso.
    </p>

    <div class="linear-card p-8 rounded-lg border border-[#1f1f24] bg-[#08080c]/40 text-left space-y-6">
      <div id="form-feedback" class="text-sm mt-4 hidden"></div>

      <form id="contact-form-apps-admin" class="space-y-4">
        <div>
          <label class="block text-[10px] font-mono text-[#cbd5e1] uppercase tracking-wider mb-2 font-medium" for="app_name" data-i18n="svcAppsAdmin.n25">Nombre y Apellido</label>
          <input
            class="w-full bg-black border border-[#1f1f24] rounded px-4 py-3 text-xs text-white placeholder-neutral-800 focus:outline-none focus:border-white transition-colors"
            type="text"
            id="app_name"
            name="name"
            placeholder="Ej. Carlos Mendoza" data-i18n-placeholder="svcAppsAdmin.n26"
            required
          />
        </div>

        <div>
          <label class="block text-[10px] font-mono text-[#cbd5e1] uppercase tracking-wider mb-2 font-medium" for="app_email" data-i18n="svcAppsAdmin.n27">Correo Corporativo</label>
          <input
            class="w-full bg-black border border-[#1f1f24] rounded px-4 py-3 text-xs text-white placeholder-neutral-800 focus:outline-none focus:border-white transition-colors"
            type="email"
            id="app_email"
            name="email"
            placeholder="carlos@tuempresa.com" data-i18n-placeholder="svcAppsAdmin.n28"
            required
          />
        </div>

        <div>
          <label class="block text-[10px] font-mono text-[#cbd5e1] uppercase tracking-wider mb-2 font-medium" for="app_message" data-i18n="svcAppsAdmin.n29">Cuéntanos qué necesitas administrar</label>
          <textarea
            class="w-full bg-black border border-[#1f1f24] rounded px-4 py-3 text-xs text-white placeholder-neutral-800 focus:outline-none focus:border-white transition-colors min-h-[100px]"
            id="app_message"
            name="message"
            placeholder="¿Qué plataformas tienes en producción y qué proveedores de identidad, ERP o CRM usan hoy tus equipos?" data-i18n-placeholder="svcAppsAdmin.n30"
            required
          ></textarea>
        </div>

        <input type="hidden" name="service" value="administrador-aplicaciones-empresariales" />

        <button
          type="button"
          data-original-text="Solicitar plan de administración"
          class="w-full py-3 bg-white text-black font-semibold text-xs rounded hover:bg-neutral-200 transition-colors duration-200"
          onclick="submitFormAppsAdmin()"
        >
          <span data-i18n="svcAppsAdmin.n31">Solicitar plan de administración</span>
        </button>

        <p class="text-[10px] text-[#737373] text-center mt-4 font-mono" data-i18n="svcAppsAdmin.n32">Tus datos están protegidos. Sin spam, garantizado.</p>
      </form>

      <div class="glow-line" aria-hidden="true"></div>

      <!-- CTA alternativo: consulta directa sin formulario -->
      <a
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full flex items-center justify-center gap-2 py-3 border border-[#1f1f24] rounded text-xs font-medium text-white hover:bg-white/[0.04] hover:border-white/20 transition-colors"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
        </svg>
        <span data-i18n="svcAppsAdmin.n33">Consulta directa por WhatsApp</span>
      </a>
    </div>
  </div>

  <script is:inline>
    // El handler del botón se declara aquí (y no en un módulo empaquetado por
    // Astro) porque los módulos tienen ámbito propio y el onclick no
    // encontraría la función. Mismo patrón que /servicios/desarrollo-wordpress.
    async function submitFormAppsAdmin() {
      const form = document.getElementById('contact-form-apps-admin');
      const feedback = document.getElementById('form-feedback');
      const btn = form?.querySelector('button[type="button"]');
      // Mensajes dinámicos en el idioma activo (la carga del motor i18n en
      // BaseLayout ya inicializó window.vortexI18n antes de cualquier submit).
      const translate = (key, fallback) => {
        const i18n = window.vortexI18n;
        return i18n ? i18n.t(key, fallback) : fallback;
      };

      if (!form || !(form instanceof HTMLFormElement) || !btn) { return; }
      if (!(feedback instanceof HTMLElement)) { return; }

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      btn.disabled = true;
      btn.textContent = translate('svcAppsAdmin.form.sending', 'Enviando...');

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          body: new FormData(form)
        });
        const data = await res.json();

        if (data.success) {
          feedback.className = 'text-sm mt-4 text-green-400';
          feedback.textContent = translate('svcAppsAdmin.form.success', '¡Mensaje enviado con éxito! Te contactaremos pronto.');
          feedback.classList.remove('hidden');
          form.reset();
        } else {
          throw new Error(data.error);
        }
      } catch (err) {
        feedback.className = 'text-sm mt-4 text-red-400';
        feedback.textContent = translate('svcAppsAdmin.form.error', 'Error al enviar. Intenta de nuevo o escríbenos a info@vortexlm.com.');
        feedback.classList.remove('hidden');
      } finally {
        btn.disabled = false;
        btn.textContent = translate(
          'svcAppsAdmin.form.submit',
          btn.getAttribute('data-original-text') || 'Solicitar plan de administración'
        );
      }
    }
  </script>
</section>
</BaseLayout>


